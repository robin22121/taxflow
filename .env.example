# --- Backend ---
APP_ENV=dev
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-prod-32-bytes-min-xxxxxxxx
APP_BASE_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:3000

# Database (NCP Cloud DB for PostgreSQL in prod, SQLite fallback for dev)
DATABASE_URL=postgresql+asyncpg://taxflow:taxflow@localhost:5432/taxflow
# Or for quick local dev:
# DATABASE_URL=sqlite+aiosqlite:///./taxflow.db

REDIS_URL=redis://localhost:6379/0

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Encryption (주민번호 등 민감정보) — NCP KMS-wrapped key in prod
RRN_ENCRYPTION_KEY=  # 32-byte base64; generate with: openssl rand -base64 32

# JWT
JWT_SECRET=change-me-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14

# ── 카카오 알림톡 ──────────────────────────────────────────
# 우선순위: nhn_cloud > aligo > stub. 'auto' 미지원 — provider를 명시하세요.
KAKAO_ALIMTALK_PROVIDER=stub  # stub | aligo | nhn_cloud
# Aligo
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
# NHN Cloud Notification
NHN_CLOUD_APP_KEY=
NHN_CLOUD_SECRET_KEY=
NHN_CLOUD_SENDER_KEY=

# ── 이메일 ───────────────────────────────────────────────
# 우선순위: auto이면 resend > ncp_outbound > sendgrid > stub 순으로 설정값 보고 자동 선택.
EMAIL_PROVIDER=auto  # auto | resend | ncp_outbound | sendgrid | stub
# Resend (권장)
RESEND_API_KEY=
RESEND_FROM_EMAIL=  # 예: noreply@easyonechon.co.kr (도메인 인증 필요)
# NCP Cloud Outbound Mailer
NCP_OUTBOUND_ACCESS_KEY=
NCP_OUTBOUND_SECRET_KEY=
NCP_OUTBOUND_SENDER_ADDRESS=
NCP_OUTBOUND_SENDER_NAME=이지원천
# SendGrid (백업)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── STT ──────────────────────────────────────────────────
STT_PROVIDER=stub  # stub | clova | whisper
# CLOVA Speech (NCP)
CLOVA_INVOKE_URL=  # https://clovaspeech-api.ncloud.com/external/v1/{...}
CLOVA_SECRET_KEY=

# ── NCP Object Storage ───────────────────────────────────
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_REGION=kr-standard
NCP_OBJECT_STORAGE_ACCESS_KEY=
NCP_OBJECT_STORAGE_SECRET_KEY=
NCP_OBJECT_STORAGE_BUCKET=taxflow-uploads

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
